// Product identity and business foundation. Never use assessment databases for these models.
generator client {
  provider = "prisma-client"
  output = "./generated"
  moduleFormat = "esm"
  runtime = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas = ["product"]
}

model User {
  id String @id @db.Text
  name String @db.Text
  email String @unique @map("emailCanonical") @db.Text
  emailVerified Boolean @default(false)
  // Platform operations only; never a business membership or signup field.
  // DB-only default: Prisma must omit this protected column on ordinary INSERT.
  isAdministrator Boolean @default(dbgenerated("false"))
  disabledAt DateTime? @db.Timestamptz(3)
  deletionRequestedAt DateTime? @db.Timestamptz(3)
  image String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  accounts Account[]
  sessions Session[]
  acceptances TermsAcceptance[]
  issuances EmailVerificationIssuance[]
  businessMemberships BusinessMember[]
  @@schema("product")
}

model Account {
  id String @id @db.Text
  accountId String @db.Text
  providerId String @db.Text
  userId String @db.Text
  // Better Auth's password field contains an encoded Argon2id hash, never plaintext.
  password String? @db.Text
  accessToken String? @db.Text
  refreshToken String? @db.Text
  idToken String? @db.Text
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([providerId,accountId])
  @@index([userId])
  @@schema("product")
}

model Session {
  id String @id @db.Text
  token String @unique @db.Text
  userId String @db.Text
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String? @db.Text
  userAgent String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@index([userId])
  @@index([expiresAt])
  @@schema("product")
}

model Verification {
  id String @id @db.Text
  identifier String @db.Text
  value String @db.Text
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  issuance EmailVerificationIssuance?
  @@index([identifier])
  @@index([expiresAt])
  @@schema("product")
}

model TermsVersion {
  id String @id @db.Text
  version String @unique @db.Text
  contentDigest String @db.Text
  immutableDocumentRef String @db.Text
  isTestFixture Boolean @default(false)
  approvedAt DateTime? @db.Timestamptz(3)
  effectiveAt DateTime? @db.Timestamptz(3)
  acceptances TermsAcceptance[]
  @@schema("product")
}

model TermsAcceptance {
  id String @id @db.Text
  userId String @db.Text
  termsVersionId String @db.Text
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)
  context String @db.Text
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  terms TermsVersion @relation(fields:[termsVersionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([userId,termsVersionId])
  @@index([termsVersionId])
  @@schema("product")
}

model EmailOutbox {
  id String @id @db.Text
  // Stable product issuance identity survives deletion of a library challenge.
  issuanceId String @unique @db.Text
  templateVersion String @db.Text
  payloadCiphertext Bytes
  nonce Bytes
  authTag Bytes
  keyId String @db.Text
  status String @default("pending") @db.Text
  attemptCount Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  issuance EmailVerificationIssuance @relation(fields:[issuanceId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@index([status,availableAt])
  @@schema("product")
}
// Stable lifecycle owner; library Verification remains the plugin storage format.
model EmailVerificationIssuance {
  purpose String @default("email-verification") @db.Text
  id String @id @db.Text
  userId String @db.Text
  emailCanonical String @db.Text
  verificationId String? @unique @db.Text
  verifier Bytes
  verifierKeyId String @db.Text
  failedAttempts Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  supersededAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  verification Verification? @relation(fields:[verificationId],references:[id],onDelete:SetNull,onUpdate:Restrict)
  outbox EmailOutbox?
  @@index([userId,createdAt])
  @@index([expiresAt])
  @@schema("product")
}
// Shared authentication abuse counters; no user FK (unknown accounts count too).
// Additive proposal only. Policy changes require a new scoped key version.
model AuthRateBucket {
  keyDigest String @id @db.Text
  capacity Int
  refillIntervalMs Int
  tokens Int
  refilledAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  lastAllowed Boolean
  @@index([expiresAt, keyDigest])
  @@schema("product")
}

// A primary owner is a specific membership, not a role on the global identity.
model Business {
  id String @id @db.Text
  primaryOwnerUserId String @unique @db.Text
  name String @db.Text
  timeZone String @default("Africa/Lagos") @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  // SQL defers this required FK until COMMIT so Business + owner membership
  // can be inserted atomically. Prisma cannot express that deferral.
  primaryOwner BusinessMember @relation("PrimaryBusinessOwner",fields:[id,primaryOwnerUserId],references:[businessId,userId],onDelete:NoAction,onUpdate:Restrict)
  members BusinessMember[] @relation("BusinessMembers")
  clients Client[]
  @@schema("product")
}

model BusinessMember {
  businessId String @db.Text
  userId String @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation("BusinessMembers",fields:[businessId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  // The composite FK and Business primary key limit this inverse to zero or one.
  // A Prisma list avoids an otherwise redundant composite unique index.
  primaryOwnerships Business[] @relation("PrimaryBusinessOwner")
  // No global userId uniqueness: non-owning relationships are not ownership.
  // Only Business.primaryOwner grants ownership; no staff/client flow is enabled.
  @@id([businessId,userId])
  @@index([userId])
  @@schema("product")
}

// Business-owned contact record, not a global login identity or portal authorization.
model Client {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Text
  fullName String @db.Text
  phone String? @db.Text
  email String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  measurementVersions MeasurementVersion[]
  orders Order[]
  @@unique([businessId,id])
  @@index([businessId,createdAt,id])
  @@schema("product")
}

// One complete, immutable measurement-taking event. Future corrections append a version.
model MeasurementVersion {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Text
  clientId String @db.Uuid
  versionNumber Int
  unit String @db.Text
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  client Client @relation(fields:[businessId,clientId],references:[businessId,id],onDelete:Restrict,onUpdate:Restrict)
  entries MeasurementEntry[]
  orderItems OrderItem[]
  @@unique([clientId,id])
  @@unique([clientId,versionNumber])
  @@schema("product")
}

model MeasurementEntry {
  measurementVersionId String @db.Uuid
  name String @db.Text
  // Unconstrained NUMERIC: the SQL scale check rejects excess precision before rounding.
  value Decimal @db.Decimal
  measurementVersion MeasurementVersion @relation(fields:[measurementVersionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  // SQL additionally enforces case-insensitive label uniqueness with lower(name).
  @@id([measurementVersionId,name])
  @@schema("product")
}

// One business-owned Client's order; identity and assignment are not runtime-editable.
model Order {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Text
  clientId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  client Client @relation(fields:[businessId,clientId],references:[businessId,id],onDelete:Restrict,onUpdate:Restrict)
  items OrderItem[]
  @@unique([id,clientId])
  @@index([businessId,createdAt,id])
  @@index([businessId,clientId,createdAt,id])
  @@schema("product")
}

// One clothing item. clientId binds both its Order and any explicit measurement selection.
model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  clientId String @db.Uuid
  description String @db.Text
  measurementVersionId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  order Order @relation(fields:[orderId,clientId],references:[id,clientId],onDelete:Restrict,onUpdate:Restrict)
  measurementVersion MeasurementVersion? @relation(fields:[clientId,measurementVersionId],references:[clientId,id],onDelete:Restrict,onUpdate:Restrict)
  @@index([orderId,createdAt,id])
  @@index([clientId,measurementVersionId])
  @@schema("product")
}
