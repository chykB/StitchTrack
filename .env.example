# Assessment experiment settings. No credentials supplied by default.
ENABLE_PERSISTENCE_EXPERIMENT=false
EXPERIMENT_DATABASE_URL=
EXPERIMENT_EXPECTED_DATABASE=
EXPERIMENT_EXPECTED_HOST=
EXPERIMENT_EXPECTED_PORT=
EXPERIMENT_EXPECTED_USER=
# Optional: unused loopback port for the assessment application's failure test.
EXPERIMENT_FAILURE_PORT=

# StitchTrack product — local development template
# Copy these variable names to .env.local; never commit actual credentials.

PRODUCT_DATABASE_MODE=development
PRODUCT_DATABASE_CONFIRMED=false
PRODUCT_DEV_DATABASE_URL=

# SMTP delivery — disabled until explicitly configured and enabled
PRODUCT_SMTP_HOST=
PRODUCT_SMTP_PORT=
PRODUCT_SMTP_TLS_MODE=
PRODUCT_SMTP_USERNAME=
PRODUCT_SMTP_PASSWORD=
PRODUCT_SMTP_FROM_ADDRESS=
PRODUCT_SMTP_FROM_NAME=StitchTrack

# Email worker: explicit owner-run CLI only; keep disabled until reviewed.
PRODUCT_EMAIL_WORKER_ENABLED=false
# Must match registration's separate HMAC/encryption key rings (32-byte base64).
# No keys are supplied here; existing synthetic integration keys are unusable.
PRODUCT_EMAIL_VERIFIER_KEY_ID=
PRODUCT_EMAIL_VERIFIER_KEY=
PRODUCT_EMAIL_OUTBOX_KEY_ID=
PRODUCT_EMAIL_OUTBOX_KEY=
