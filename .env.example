# Assessment experiment settings. No credentials supplied by default.
ENABLE_PERSISTENCE_EXPERIMENT=false
EXPERIMENT_DATABASE_URL=
EXPERIMENT_EXPECTED_DATABASE=
EXPERIMENT_EXPECTED_HOST=
EXPERIMENT_EXPECTED_PORT=
EXPERIMENT_EXPECTED_USER=
# Optional: unused loopback port for the assessment application's failure test.
EXPERIMENT_FAILURE_PORT=

# StitchTrack product — local development template
# Copy these variable names to .env.local; never commit actual credentials.

PRODUCT_DATABASE_MODE=development
PRODUCT_DATABASE_CONFIRMED=false
PRODUCT_DEV_DATABASE_URL=

# SMTP delivery — disabled until explicitly configured and enabled
PRODUCT_SMTP_HOST=
PRODUCT_SMTP_PORT=
PRODUCT_SMTP_TLS_MODE=
PRODUCT_SMTP_USERNAME=
PRODUCT_SMTP_PASSWORD=
PRODUCT_SMTP_FROM_ADDRESS=
PRODUCT_SMTP_FROM_NAME=StitchTrack

# Email worker: explicit owner-run CLI only; keep disabled until reviewed.
PRODUCT_EMAIL_WORKER_ENABLED=false
# Must match registration's separate HMAC/encryption key rings (32-byte base64).
# No keys are supplied here; existing synthetic integration keys are unusable.
PRODUCT_EMAIL_VERIFIER_KEY_ID=
PRODUCT_EMAIL_VERIFIER_KEY=
PRODUCT_EMAIL_OUTBOX_KEY_ID=
PRODUCT_EMAIL_OUTBOX_KEY=

# Local signup/OTP only: no consent is collected and no Terms rows are created.
# Production refuses this policy. Routine Next.js development uses the explicitly opted-in
# loopback HTTP transport below; the historical HTTPS gateway is not a prerequisite.
ENABLE_PRODUCT_REGISTRATION_HTTP=false
PRODUCT_DEVELOPMENT_CONSENT_DEFERRED=false
PRODUCT_REGISTRATION_RATE_POLICY_CONFIRMED=false
# Explicit local JSON policies for signup, verify-email, resend-verification;
# each needs version (local-*), account/ip capacity and refillIntervalMs. No defaults.
PRODUCT_REGISTRATION_RATE_POLICIES=

# Explicit HTTP exception: development only, exact localhost/127.0.0.1:3000,
# actual loopback socket, no proxy/forwarding trust. Production always refuses.
PRODUCT_LOCAL_HTTP_CONFIRMED=false
# Historical HTTPS proof only; not required for routine development.
PRODUCT_LOCAL_HTTPS_CONFIRMED=false

# Next-only local Signup/OTP runtime (no URLs or keys supplied by default).
PRODUCT_TEST_DATABASE_URL=
PRODUCT_LOCAL_RATE_IDENTIFIER_KEY=
PRODUCT_SESSION_HTTP_AUTH_SECRET=
PRODUCT_SESSION_HTTP_ORIGIN=
ENABLE_LOCAL_AUTH_FRONTEND=false
PRODUCT_SINGLE_ORIGIN_CONFIRMED=false
ENABLE_PRODUCT_SESSION_HTTP=false

# Task Five local session transport: retain a nonsecret UUID counter namespace.
# Existing private keys are reused; never substitute a key into an old fixture.
# Production limits remain unapproved; this confirms the reviewed local budgets only.
PRODUCT_LOCAL_RATE_POLICY_CONFIRMED=false
PRODUCT_SINGLE_ORIGIN_RUN_ID=
PRODUCT_SESSION_TOKEN_KEY=

# Default-disabled local password reset; requires the reviewed fourth migration/grant.
ENABLE_PRODUCT_PASSWORD_RESET_HTTP=false
PRODUCT_RESET_RATE_POLICY_CONFIRMED=false
# One shared reset budget for request/check/complete; explicit AuthRatePolicy JSON.
PRODUCT_RESET_RATE_POLICY=
# Separate owner-only migration confirmation, never normal runtime authorization.
PRODUCT_PASSWORD_RESET_MIGRATION_CONFIRMED=false
